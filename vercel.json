{
  "version": 2,
  "buildCommand": "bun run build",
  "outputDirectory": ".output/public",
  "headers": [
    {
      "source": "/(index.html|sw.js|registerSW.js|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
